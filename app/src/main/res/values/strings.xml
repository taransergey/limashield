    <string name="onb_title">LimaShield setup</string>
    <string name="onb_intro">For the filter to protect every app on this phone, Android requires a one-time setup. Follow the steps — the checkmarks update automatically.</string>
    <string name="onb_step1_title">1. Location access</string>
    <string name="onb_step1_desc">The filter needs GPS and network position to detect spoofing.</string>
    <string name="onb_step1_btn">Grant</string>
    <string name="onb_step2_title">2. Developer mode</string>
    <string name="onb_step2_desc">Open About phone and tap “Build number” 7 times until it says you are now a developer.\n%1$s</string>
    <string name="onb_step2_btn">Open About phone</string>
    <string name="onb_step2_hint_coloros">On this phone: Settings → About device → Version → tap “Build number” 7 times.</string>
    <string name="onb_step2_hint_miui">On this phone: Settings → About phone → tap “MIUI version” 7 times.</string>
    <string name="onb_step2_hint_samsung">On this phone: Settings → About phone → Software information → tap “Build number” 7 times.</string>
    <string name="onb_step2_hint_generic">Can\'t find it? Search Settings for “build number”.</string>
    <string name="onb_step3_title">3. Mock location app</string>
    <string name="onb_step3_desc">In developer options find “Select mock location app” (usually under Debugging) and choose LimaShield.\nCan\'t find it? Use the Settings search: type “mock”.</string>
    <string name="onb_step3_btn">Open developer options</string>
    <string name="onb_step3_toast">Find “Select mock location app” → LimaShield</string>
    <string name="onb_step3_need_step2">First enable Developer mode (step 2)</string>
    <string name="onb_step4_title">4. Battery (recommended)</string>
    <string name="onb_step4_desc">Exclude LimaShield from battery optimization so the system doesn\'t kill the filter on the road.</string>
    <string name="onb_step4_btn">Exclude</string>
    <string name="onb_all_set">Everything is set up!</string>
    <string name="onb_start_filter">Start the filter</string>
    <string name="onb_done">Done</string>

